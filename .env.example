# Deriv is the sole broker and market-data source.
# These are Deriv's official API credentials, not a third-party data provider.
# Keep credentials private in .env; never commit this file.
DERIV_APP_ID=
DERIV_API_TOKEN=
# Must match the currency of the selected Deriv Options account.
AUTO_CURRENCY=USD
# demo is the safe default. Change to real only after verifying account ID and risk limits.
TRADING_MODE=demo
AUTO_TRADE=false
AUTO_START=false
# Required only for live-money mode. Exact acknowledgement string:
LIVE_TRADING_ACK=
AUTO_ACCOUNT_ID=
AUTO_MARKETS=R_10,R_25
AUTO_GRANULARITY=60
AUTO_DURATION=1
AUTO_DURATION_UNIT=m
MIN_SIGNAL_SCORE=70
SCAN_INTERVAL_MS=15000
ENGINE=options
PORT=8787
MAX_DAILY_LOSS=5
MAX_TRADES_PER_DAY=5
MAX_CONSECUTIVE_LOSSES=2
COOLDOWN_SECONDS=180
DEFAULT_STAKE=1
MAX_STAKE=5
# Optional Node.js stake progression. Disabled by default; when enabled, the 1-2-3-4-5 ladder is capped by MAX_STAKE.
STAKE_PROGRESSION_ENABLED=false
STAKE_PROGRESSION=1,2,3,4,5
